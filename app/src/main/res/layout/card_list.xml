<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    app:cardElevation="20dp"
    app:cardCornerRadius="30dp"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


            <TextView
                android:id="@+id/activityinfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1616"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat"
                android:text="Belajar React JS" />

        <!-- TextView kedua vertikal di bawah -->
        <TextView
            android:id="@+id/descinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#1D1616"
            android:textSize="15sp"
            android:layout_below="@id/activityinfo"
            android:fontFamily="sans-serif"
            android:text="Belajar React JS dan belajar memahaminya hingga suatu saat nanti selalu bersamanyam dan saya juga belajar MERN yang sangat mudah dan seru untuk dipelajari" />



            <TextView
                android:id="@+id/dateinfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_below="@+id/descinfo"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif"
                android:text="10/02/2024" />
            <TextView
                android:id="@+id/timeinfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dateinfo"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:text="12:30 PM" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/descinfo"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/checkicon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/baseline_check_35"
                android:background="@drawable/efarrow"
                />

            <ImageView
                android:id="@+id/delicon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/baseline_delete_35"
                android:background="@drawable/efarrow"
                />
            <ImageView
                android:id="@+id/edticon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:background="@drawable/efarrow"
                android:src="@drawable/baseline_edit_35"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>