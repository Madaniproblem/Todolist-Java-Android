<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#98D8EF"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1D1616">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backtomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:paddingTop="5dp"
                android:background="@drawable/efarrow"
                android:layout_marginStart="-5dp"
                android:src="@drawable/baseline_arrow_back_40"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="27sp"
                android:fontFamily="@font/montserrat"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:text="Back"/>
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
<ScrollView
    android:layout_width="match_parent"
    android:scrollbars="none"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="-50dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What do you want to do  ?"
            android:layout_gravity="center"
            android:textSize="25sp"
            android:textColor="#1D1616"
            android:fontFamily="@font/montserrat"
            android:gravity="center"/>


            <EditText
                android:id="@+id/activityadd"
                android:layout_width="match_parent"
                android:background="@drawable/edtcl"
                android:drawableStart="@drawable/baseline_directions_run_35"
                android:padding="15dp"
                android:paddingTop="20dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="10dp"
                android:drawablePadding="15dp"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:hint="Input your activity"
                android:fontFamily="sans-serif"
                android:textSize="17sp"/>



            <EditText
                android:id="@+id/descadd"
                android:background="@drawable/edtcl"
                android:padding="15dp"
                android:fontFamily="sans-serif"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/baseline_edit_35"
                android:drawablePadding="15dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:maxLength="500"
                android:layout_marginEnd="10dp"
                android:hint="Input description"
                android:inputType="textMultiLine"
                android:textSize="17sp"/>
        <EditText
            android:id="@+id/dateadd"
            android:background="@drawable/edtcl"
            android:padding="15dp"
            android:fontFamily="sans-serif"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/baseline_date_ranges_35"
            android:drawablePadding="15dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:maxLength="500"
            android:layout_marginEnd="10dp"
            android:hint="Input date"
            android:inputType="textMultiLine"
            android:textSize="17sp"/>
        <EditText
            android:id="@+id/timeadd"
            android:background="@drawable/edtcl"
            android:padding="15dp"
            android:fontFamily="sans-serif"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/baseline_lock_clock_35"
            android:drawablePadding="15dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:maxLength="500"
            android:layout_marginEnd="10dp"
            android:hint="Input time"
            android:inputType="textMultiLine"
            android:textSize="17sp"/>


        <Button
            android:id="@+id/senddataadd"
            android:layout_width="match_parent"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="Submit"
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/cbtn"
            android:fontFamily="@font/montserrat"
            android:foreground="?android:selectableItemBackground"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>

</LinearLayout>
