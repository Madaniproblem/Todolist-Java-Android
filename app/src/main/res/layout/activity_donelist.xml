<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#98D8EF"
    tools:context=".Donelist">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/appbars"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1D1616">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titledefense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25sp"
                android:gravity="center"
                android:fontFamily="@font/montserrat"
                android:textColor="#FBFBFB"
                android:text="Your Completed plan "/>

        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rreviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/appbars"
                android:layout_marginBottom="50dp" />

</RelativeLayout>